# ─────────────────────────────────────────────
#  AI Intelligence Hub — Environment Variables
# ─────────────────────────────────────────────

# Cloud API Keys (leave empty to use mock responses)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Backend server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Local LLM endpoints (Ollama / LM Studio)
OLLAMA_BASE_URL=http://localhost:11434
LM_STUDIO_BASE_URL=http://localhost:1234

# Hardware profile (used by HardwareGuard)
GPU_VRAM_GB=8
GPU_MODEL=GTX_1070_Ti
